#!/bin/sh
# RevOps SaaS - Comprehensive Pre-commit Test Runner (Synchronized with CI)

echo "⚡ [pre-commit] Проверка линтером (Ruff)..."
ruff check apps/ packages/ workers/ tests/ --ignore E501 || true

echo "⚡ [pre-commit] Проверка Python синтаксиса и типов..."
mypy apps/ packages/ --ignore-missing-imports --explicit-package-bases || exit 1

echo "⚡ [pre-commit] Запуск бэкенд-тестов..."
pytest tests -q || exit 1

echo "⚡ [pre-commit] Запуск набора юнит-тестов Vitest (фронтенд)..."
npm test || exit 1

echo "✅ [pre-commit] Все проверки синтаксиса, типов и тестов (бэкенд + фронтенд) пройдены успешно."
exit 0
