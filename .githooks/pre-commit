#!/bin/sh
# RevOps SaaS - Comprehensive Pre-commit Test Runner (Synchronized with CI)

echo "🔍 [pre-commit] Anti-fake-fallback scan..."
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACM | grep -E "apps/web/js/.*\.js$" | grep -v "\.test\.js$" | grep -v "tests/" || true)
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep -E "apps/api/routers/.*\.py$" | grep -v "test_" || true)

FAILED=0
for file in $STAGED_JS; do
  if [ -f "$file" ]; then
    if grep -E "length\s*\*\s*[1-9][0-9]{4,}" "$file" | grep -v "fallback-allowed" >/dev/null 2>&1; then
      echo "❌ $file: length * CONSTANT"
      FAILED=1
    fi
    if grep -E "return\s+300000" "$file" >/dev/null 2>&1; then
      echo "❌ $file: return 300000"
      FAILED=1
    fi
  fi
done

for file in $STAGED_PY; do
  if [ -f "$file" ]; then
    if grep -E "\[1\] \* 13" "$file" | grep -v "fallback-allowed" >/dev/null 2>&1; then
      echo "❌ $file: [1]*13 fake all-passed"
      FAILED=1
    fi
  fi
done

if [ "$FAILED" = "1" ]; then
  echo "🚨 COMMIT BLOCKED: fake fallback detected."
  echo "   Rule: return 0 + visible error, NEVER fake numbers."
  echo "   Docs: docs/NO_FAKE_FALLBACK_POLICY.md"
  exit 1
fi

echo "⚡ [pre-commit] Проверка критического синтаксиса линтером (Ruff)..."
ruff check apps/ packages/ workers/ scripts/telegram_backup_engine.py --select E9,F63,F7,F82 || exit 1

echo "⚡ [pre-commit] Проверка Python синтаксиса и типов (Mypy)..."
mypy apps/ packages/ workers/ scripts/telegram_backup_engine.py --ignore-missing-imports --explicit-package-bases || exit 1

echo "⚡ [pre-commit] Запуск бэкенд-тестов (Pytest)..."
pytest tests -q || exit 1

echo "⚡ [pre-commit] Запуск набора юнит-тестов Vitest (фронтенд)..."
npm test || exit 1

echo "✅ [pre-commit] Все проверки синтаксиса, типов и тестов (бэкенд + фронтенд + anti-fake) пройдены успешно."
exit 0
