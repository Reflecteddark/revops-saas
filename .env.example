# RevOps Intelligence SaaS — Environment Variables Template
# Скопируйте этот файл в .env на сервере и заполните значения

# Секретный ключ администратора для доступа к API (/api/v1/...)
REVOPS_ADMIN_KEY=your_secure_admin_key_here

# Строка подключения к SQLite базе данных (внутри контейнера)
DATABASE_URL=sqlite:////app/data/revops_saas.db

# Путь к реестру тенантов (монтируется с хоста)
TENANTS_REGISTRY_PATH=/opt/revops-enterprise-os/tenants_registry.json

# Настройки окружения приложения
PYTHONPATH=/app
PORT=8000
HOST=0.0.0.0
