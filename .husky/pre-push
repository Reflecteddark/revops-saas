#!/usr/bin/env sh
echo "🧪 Pre-push: full test suite (ruff + mypy + pytest + vitest)..."

# 1. Ruff полный
ruff check apps/ tests/ || exit 1

# 2. Mypy полный
mypy apps/api/ packages/ --ignore-missing-imports --explicit-package-bases || exit 1

# 3. Anti-fake pytest
pytest tests/test_no_fake_fallbacks.py -v || exit 1

# 4. Полный pytest (2 мин)
pytest tests/ -x --tb=short || exit 1

# 5. Frontend vitest
if [ -f "apps/web/package.json" ]; then
  (cd apps/web && npm test -- --run) || exit 1
else
  npm test || exit 1
fi

echo "✅ Pre-push passed"
